# Operating System Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# Workspace Logs & Temporary Artifacts
*.log
*.tmp
*.temp
*.bak
/tmp/
/temp/
.history/

# Centralized Release & Build Outputs
/dist/
# Keep tracked release tooling under build\; ignore other build artifacts and last-run logs.
/build/*
!/build/vento-unified-safe-release.bat
!/build/logs/
/build/logs/*
!/build/logs/.gitkeep
/debug_symbols/
*.apk
*.aab
app.*.symbols
app.*.map.json

# Signing Keys & Local Secrets (Defense-in-Depth)
*.jks
*.keystore
key.properties
local.properties
secrets/
*_signing_key.json

# Node / Status Query API & SPA (defense-in-depth; submodule .gitignore remains authoritative)
node_modules/
.env
.env.*
!.env.example
!.env.production
*.tsbuildinfo
coverage/
